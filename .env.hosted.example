# NeatMind hosted-service template.
# Copy to .env.hosted or, preferably, inject these values with a deployment secret
# manager. Never place real sk_*, whsec_*, database, OAuth, or AI-provider secrets
# here, and never paste them into a chat, an issue, or a commit.
#
#   Copy-Item .env.hosted.example .env.hosted
#
# .env.hosted is ignored by Git. Start the service with:  npm run hosted:serve

# ---------------------------------------------------------------------------
# Billing
# ---------------------------------------------------------------------------

# Billing is deliberately disabled. Enabling it activates fail-closed validation for
# every required Stripe value and explicit policy decision below.
BILLING_ENABLED=false
BILLING_PROVIDER=stripe
ALLOW_LIVE_BILLING=false

# Pin and review the Stripe API version used by the hosted adapter. It must match
# the installed SDK (stripe@22.3.2 pins 2026-06-24.dahlia); upgrade both together.
STRIPE_API_VERSION=2026-06-24.dahlia

# Server-side Stripe values. Use sk_test_* until sandbox verification is complete.
# The selected hosted Checkout flow does not require a publishable pk_* key.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Must be recurring USD prices on ONE product, with interval_count 1:
#   monthly  $4.99      annual  $39.99
# The service verifies each Price against that catalog before any Checkout and
# refuses to start a session if an amount, currency, or interval differs.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=

# Reserved. Leave blank. $39.99 is the permanent annual price, so no first-term
# founding offer exists; supplying this value is deliberately rejected, because a
# promotional first term would need eligibility plus a renewal-price transition.
STRIPE_PRICE_FOUNDING_ANNUAL=

# These must be explicitly set to true/false/a number before BILLING_ENABLED=true.
# Leaving them blank prevents an accidental policy choice.
#   STRIPE_AUTOMATIC_TAX   must be false unless every Price has an explicit
#                          tax_behavior and Stripe Tax is configured
#   REFUND_REVOKES_ACCESS  whether a full refund ends Pro immediately
#   BILLING_GRACE_DAYS     failed-renewal grace period, 0 through 30
STRIPE_AUTOMATIC_TAX=
REFUND_REVOKES_ACCESS=
BILLING_GRACE_DAYS=

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------

# Fixed first-party HTTPS origin only, with no path, query, credentials, or
# fragment. Checkout return URLs, the Customer Portal return URL, the OAuth
# redirect, and the session token audience are all derived from this one value.
PUBLIC_APP_ORIGIN=

HOSTED_API_HOST=127.0.0.1
HOSTED_API_PORT=8790

# Where account, subscription, entitlement, session, and usage state is persisted.
# Required: without it a restart would forget who has paid. Back this file up.
HOSTED_SQLITE_PATH=./.neatmind-hosted/hosted.sqlite

# Exact Chrome extension origins allowed to call the API, comma separated, e.g.
# chrome-extension://abcdefghijklmnopabcdefghijklmnop
HOSTED_ALLOWED_EXTENSION_ORIGINS=

# Optional extra sign-in redirect targets. https://<extension-id>.chromiumapp.org/
# is always accepted; this exists for staging harnesses only.
HOSTED_ALLOWED_REDIRECT_URIS=

# Terminate TLS here by pointing at a certificate and key, or leave both blank and
# terminate HTTPS in a reverse proxy in front of the service. Setting only one is
# rejected at startup.
HOSTED_TLS_CERT_PATH=
HOSTED_TLS_KEY_PATH=

# ---------------------------------------------------------------------------
# Identity and signing keys
# ---------------------------------------------------------------------------

# At least 32 bytes of server-only random data. Signs hosted session tokens and
# OAuth state. Rotating it signs everyone out; it is never sent to a client.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
HOSTED_SESSION_SIGNING_KEY=

# Google Cloud console -> APIs & Services -> Credentials -> OAuth client ID, of
# type "Web application", with this authorized redirect URI:
#   <PUBLIC_APP_ORIGIN>/auth/callback
# The client secret stays on the server; the extension never receives it.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Required whenever the hosted generation route is wired. Generate at least 32
# random bytes, store them only in the server secret manager, and rotate
# deliberately. Service assembly refuses hosted generation without it.
USAGE_REQUEST_HMAC_KEY=

# ---------------------------------------------------------------------------
# Background work and reserved dependencies
# ---------------------------------------------------------------------------

USAGE_RESERVATION_TTL_MS=600000
# How often abandoned usage reservations are released. 0 disables the sweeper.
HOSTED_SWEEP_INTERVAL_MS=60000
HOSTED_RECONCILE_INTERVAL_MS=900000

# Reserved for the future multi-replica PostgreSQL adapter. The current store is
# single-process by design; see services/hosted-api/README.md.
DATABASE_URL=
GENERATION_INTERNAL_BASE_URL=http://127.0.0.1:8787
GENERATION_INTERNAL_ACCESS_TOKEN=
