# Exam-Cram hosted-service template.
# Copy to .env.hosted or, preferably, inject these values with a deployment secret
# manager. Never place real sk_*, whsec_*, database, OIDC, or AI-provider secrets here.

# Billing is deliberately disabled. Enabling it activates fail-closed validation for
# every required Stripe value and explicit policy decision below.
BILLING_ENABLED=false
BILLING_PROVIDER=stripe
ALLOW_LIVE_BILLING=false

# Fixed first-party HTTPS origin only, with no path, query, credentials, or fragment.
# Checkout and Customer Portal return URLs are derived from this server-side value.
PUBLIC_APP_ORIGIN=

# Pin and review the Stripe API version used by the hosted adapter.
STRIPE_API_VERSION=2026-06-24.dahlia

# Server-side Stripe values. Use sk_test_* during sandbox verification. The selected
# hosted Checkout flow does not require a publishable pk_* key.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=

# Optional founding-student annual Price. Leave blank unless the offer is approved.
STRIPE_PRICE_FOUNDING_ANNUAL=

# These must be explicitly set to true/false/a number before BILLING_ENABLED=true.
# Leaving them blank prevents an accidental policy choice.
STRIPE_AUTOMATIC_TAX=
REFUND_REVOKES_ACCESS=
BILLING_GRACE_DAYS=

# Reserved production deployment dependencies. The current domain modules do not yet
# consume these values; the PostgreSQL, OIDC, HTTP, and generation adapters must add
# strict validation before public hosting.
DATABASE_URL=
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
HOSTED_ALLOWED_EXTENSION_ORIGINS=
HOSTED_API_PORT=8790
USAGE_RESERVATION_TTL_MS=600000
USAGE_REQUEST_HMAC_KEY=
GENERATION_INTERNAL_BASE_URL=http://127.0.0.1:8787
GENERATION_INTERNAL_ACCESS_TOKEN=
